set number
set NERDTree

" targets.vim: iq/aq (nærmeste quote), in/an for neste forekomst
Plug 'wellle/targets.vim'

" Options
set clipboard+=unnamed
set timeoutlen=2000
set ignorecase
set smartcase
set hlsearch
set incsearch
" Mappings
let mapleader = " "

" clear highligh on esc
nnoremap <silent> <esc> :noh<return><esc>

nnoremap <leader>rc :source ~/.ideavimrc<CR>

" IntelliJ

" manipulation
vmap gc <Action>(CommentByBlockComment)
nmap gcc <Action>(CommentByLineComment)
nmap <Leader>cr <Action>(RenameElement)
nmap <leader>cf <Action>(ReformatCode)
nmap <leader>ca <Action>(ShowIntentionActions)
nmap <leader>co <Action>(OptimizeImports)

" search and information
nmap K <Action>(ShowHoverInfo)
nmap <Leader>sr <Action>(ManageRecentProjects)
nmap <leader>sg <Action>(FindInPath)
nmap <leader>sf <Action>(GotoFile)
nmap <leader><leader> <Action>(RecentFiles)


" navigation
nmap gi <Action>(GotoImplementation)
nmap gd <Action>(GotoDeclarationOnly)
nmap gr <Action>(GotoDeclaration)
nmap gs <Action>(GotoSuperMethod)
nmap <c-o> <Action>(Back)
nmap <c-i> <Action>(Forward)
nmap <Leader>e <Action>(SelectInProjectView)
nmap -  <Action>(SelectInProjectView)
nmap <Leader>dn <Action>(GotoNextError)
nmap <Leader>dp <Action>(GotoPreviousError)

" version control
nmap <leader>gv <Action>(ActivateVersionControlToolWindow)
nmap <leader>hn <Action>(VcsShowNextChangeMarker)
nmap <leader>hp <Action>(VcsShowPrevChangeMarker)
nmap <leader>ghr <Action>(Vcs.RollbackChangedLines)
nmap <leader>ghd <Action>(Compare.SameVersion)
" nvim: <leader>gd = CodeDiff mot origin/HEAD. IntelliJ spør om branch.
nmap <leader>gd <Action>(Git.CompareWithBranch)

" debugging
nmap <leader>dr <Action>(Resume)
nmap <leader>da <Action>(Debug)
nmap <leader>ds <Action>(Stop)
nmap <leader>db <Action>(ToggleLineBreakpoint)
nmap <leader>dc <Action>(RunToCursor)

" runTest
nmap <leader>tr <Action>(RunClass)

" tabs
nmap <leader>bp <Action>(PinActiveEditorTab)
nmap <leader>bP <Action>(CloseAllUnpinnedEditors)
nmap H <Action>(PreviousTab)
nmap L <Action>(NextTab)
nmap <c-h> <Action>(PrevSplitter)
nmap <c-l> <Action>(NextSplitter)
nmap <leader>bd <Action>(CloseContent)
nmap <leader>bo <Action>(CloseAllEditorsButActive)

" Indent and keep text selected
vnoremap > >gv
vnoremap < <gv

