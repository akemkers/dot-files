#!/usr/bin/env bash
# fzf jump list for herdr: spaces (tmux sessions), their tabs (tmux windows),
# and running agents. Enter jumps.
#   ^s spaces   ^w spaces+tabs   ^a agents   ^c new space   ^x close
# Usage: herdr-fzf [spaces|agents]
set -euo pipefail

herdr_config="${HERDR_CONFIG:-$HOME/.config/herdr/config.toml}"

# Henter en quoted verdi fra en gitt seksjon i config.toml. Seksjonsbevisst fordi
# nøkler som "name" finnes i flere seksjoner.
toml_get() {
  [ -r "$herdr_config" ] || return 0
  awk -v sect="$1" -v key="$2" '
    /^[[:space:]]*\[/ { inside = ($0 ~ "^[[:space:]]*\\[" sect "\\]"); next }
    inside && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      if (match($0, /"[^"]*"/)) { print substr($0, RSTART + 1, RLENGTH - 2); exit }
    }
  ' "$herdr_config"
}

# Glyfer og farger er herdr sine egne, lest ut av sidebaren:
#   blocked ×  working ◐  done ✓  idle ○  unknown ·
# "dots" bruker ● for de tre første og skiller dem bare på farge.
case "$(toml_get ui status_indicators)" in
  symbols) glyph_blocked='×'; glyph_working='◐'; glyph_done='✓' ;;
  *)       glyph_blocked='●'; glyph_working='●'; glyph_done='●' ;;
esac
glyph_idle='○'
glyph_unknown='·'

# herdr har ingen kommando som dumper den oppløste paletten, så tokenverdiene per
# tema må ligge her. Ukjent tema faller tilbake på terminalens ANSI-farger.
case "$(toml_get theme name)" in
  tokyo-night)
    th_red='#f7768e'; th_yellow='#e0af68'; th_teal='#7dcfff'
    th_green='#9ece6a'; th_overlay0='#565f89' ;;
  catppuccin)
    th_red='#f38ba8'; th_yellow='#f9e2af'; th_teal='#94e2d5'
    th_green='#a6e3a1'; th_overlay0='#6c7086' ;;
  *)
    th_red=''; th_yellow=''; th_teal=''; th_green=''; th_overlay0='' ;;
esac

# [theme.custom] vinner over temaet, samme prioritet som herdr bruker.
token_color() {
  local custom
  custom=$(toml_get theme.custom "$1")
  printf '%s' "${custom:-$2}"
}

# Hex -> truecolor-SGR. Uten brukbar hex faller vi tilbake på ANSI-koden.
sgr() {
  local h="${1#\#}"
  if [ ${#h} -eq 6 ]; then
    printf '38;2;%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
  else
    printf '%s' "$2"
  fi
}

sgr_blocked=$(sgr "$(token_color red      "$th_red")"      31)
sgr_working=$(sgr "$(token_color yellow   "$th_yellow")"   33)
sgr_done=$(sgr    "$(token_color teal     "$th_teal")"     36)
sgr_idle=$(sgr    "$(token_color green    "$th_green")"    32)
sgr_unknown=$(sgr "$(token_color overlay0 "$th_overlay0")" 90)

icon() {
  case "$1" in
    working) printf '\033[%sm%s\033[0m' "$sgr_working" "$glyph_working" ;;
    blocked) printf '\033[%sm%s\033[0m' "$sgr_blocked" "$glyph_blocked" ;;
    done)    printf '\033[%sm%s\033[0m' "$sgr_done"    "$glyph_done" ;;
    idle)    printf '\033[%sm%s\033[0m' "$sgr_idle"    "$glyph_idle" ;;
    *)       printf '\033[%sm%s\033[0m' "$sgr_unknown" "$glyph_unknown" ;;
  esac
}

list_spaces() {
  herdr workspace list | jq -r '.result.workspaces[] | [.workspace_id, .label, .agent_status, .tab_count, .pane_count] | @tsv' |
  while IFS=$'\t' read -r id label status tabs panes; do
    printf '%s\t%s \033[1m%s\033[0m \033[90m%s tabs, %s panes\033[0m\n' \
      "$id" "$(icon "$status")" "$label" "$tabs" "$panes"
  done
}

list_tabs_of() {
  herdr tab list --workspace "$1" | jq -r '.result.tabs[] | [.tab_id, .number, .label, .agent_status] | @tsv' |
  while IFS=$'\t' read -r id num label status; do
    printf '%s\t   %s \033[90m%s\033[0m %s\n' "$id" "$(icon "$status")" "$num" "$label"
  done
}

list_all() {
  herdr workspace list | jq -r '.result.workspaces[] | [.workspace_id, .label, .agent_status, .tab_count, .pane_count] | @tsv' |
  while IFS=$'\t' read -r id label status tabs panes; do
    printf '%s\t%s \033[1m%s\033[0m \033[90m%s tabs, %s panes\033[0m\n' \
      "$id" "$(icon "$status")" "$label" "$tabs" "$panes"
    list_tabs_of "$id"
  done
}

list_agents() {
  jq -rn \
    --slurpfile ws <(herdr workspace list) \
    --slurpfile ag <(herdr agent list) '
      ($ws[0].result.workspaces | map({key: .workspace_id, value: .label}) | from_entries) as $W |
      $ag[0].result.agents[] |
      [ .pane_id, .agent_status,
        ($W[.workspace_id] // .workspace_id), (.name // .agent),
        (.terminal_title_stripped // ""), .cwd ] | @tsv' |
  while IFS=$'\t' read -r id status ws agent title cwd; do
    # Samme rekkefølge som sidebar-radene: tittel i bold, så dim workspace + agent
    printf '%s\t%s \033[1m%s\033[0m \033[90m%s\033[0m %s\n' \
      "$id" "$(icon "$status")" "${title:-${cwd/#$HOME/\~}}" "$ws" "$agent"
  done
}

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# Søkefeltet er navnet når det står noe der. Tomt søkefelt spør om navn.
create_workspace() {
  local name
  name=$(trim "${1:-}")
  if [ -z "$name" ]; then
    read -e -r -p "New space name: " name || return 0
    name=$(trim "$name")
    [ -n "$name" ] || return 0
  fi
  herdr workspace create --label "$name" --focus >/dev/null
}

# Close the selected row. Agents/panes are left alone, and a space cannot close
# itself: the popup is running inside it.
close_target() {
  local id="$1"
  case "$id" in
    *:p*) : ;;
    *:t*) herdr tab close "$id" >/dev/null 2>&1 || true ;;
    "${HERDR_WORKSPACE_ID:-__none__}")
      herdr notification show "Switch away first" --body "A space can't be closed from its own popup." >/dev/null 2>&1 || true ;;
    *)    herdr workspace close "$id" >/dev/null 2>&1 || true ;;
  esac
}

preview() {
  case "$1" in
    *:p*) herdr agent read "$1" --source recent-unwrapped --lines 200 --format ansi ;;
    *:t*) herdr pane list --workspace "${1%%:*}" |
            jq -r --arg t "$1" '.result.panes[] | select(.tab_id==$t) |
              "\(.pane_id)  \(.terminal_title_stripped // "shell")  \(.cwd)"' ;;
    *)    herdr tab list --workspace "$1" |
            jq -r '.result.tabs[] | "\(.number)  \(.label)  [\(.agent_status)]"' ;;
  esac
}

mode_file="${HERDR_FZF_MODE:-/dev/null}"

# Default-layout stabler lista oppover fra prompten, så alt samler seg nederst.
# tac motvirker det slik at lista fortsatt leses top-down.
case "${1:-}" in
  --spaces)  echo spaces > "$mode_file"; list_spaces | tac; exit 0 ;;
  --all)     echo all    > "$mode_file"; list_all    | tac; exit 0 ;;
  --agents)  echo agents > "$mode_file"; list_agents | tac; exit 0 ;;
  --relist)  case "$(cat "$mode_file" 2>/dev/null)" in
               all)    list_all    | tac ;;
               agents) list_agents | tac ;;
               *)      list_spaces | tac ;;
             esac
             exit 0 ;;
  --create)  create_workspace "${2:-}"; exit 0 ;;
  --close)   close_target "${2:-}"; exit 0 ;;
  --preview) preview "$2"; exit 0 ;;
esac

# Tokyo Night, samme tokens som herdr-temaet bruker i sidebaren. bg+ er
# selection_bg (#2d3650) slik at den valgte raden matcher sidebar-markeringen.
fzf_colors='gutter:-1'
fzf_colors+=',bg+:#2d3650,fg+:#c0caf5'
fzf_colors+=',hl:#7aa2f7,hl+:#7dcfff'
fzf_colors+=',prompt:#7aa2f7,pointer:#7aa2f7,marker:#7aa2f7,spinner:#7aa2f7'
fzf_colors+=',border:#414868,header:#565f89,info:#565f89'

self="${BASH_SOURCE[0]}"
HERDR_FZF_MODE="$(mktemp)"; export HERDR_FZF_MODE
trap 'rm -f "$HERDR_FZF_MODE"' EXIT

# Modusnavnet bor i prompten. --border-label ville krevd en hovedramme, og den
# vil vi ikke ha.
case "${1:-spaces}" in
  agents) start_list=list_agents; start_prompt='agents ❯ '; echo agents > "$HERDR_FZF_MODE" ;;
  *)      start_list=list_spaces; start_prompt='spaces ❯ '; echo spaces > "$HERDR_FZF_MODE" ;;
esac

selection=$(
  "$start_list" | tac | fzf --ansi --no-sort --delimiter='\t' --with-nth=2.. \
    --layout=default --padding='1,2' \
    --highlight-line --gutter=' ' --color="$fzf_colors" \
    --prompt="$start_prompt" --pointer='' \
    --header='  ^s spaces  ^w spaces+tabs  ^a agents  ^c new  ^x close' \
    --bind="ctrl-s:change-prompt(spaces ❯ )+reload($self --spaces)" \
    --bind="ctrl-w:change-prompt(spaces+tabs ❯ )+reload($self --all)" \
    --bind="ctrl-a:change-prompt(agents ❯ )+reload($self --agents)" \
    --bind="ctrl-c:execute($self --create {q})+abort" \
    --bind="ctrl-x:execute-silent($self --close {1})+reload($self --relist)" \
    --preview="$self --preview {1}" --preview-window='right:55%'
) || exit 0

id="${selection%%$'\t'*}"
[ -n "$id" ] || exit 0

case "$id" in
  *:p*) herdr agent focus "$id" >/dev/null ;;
  *:t*) herdr tab focus "$id"   >/dev/null ;;
  *)    herdr workspace focus "$id" >/dev/null ;;
esac
